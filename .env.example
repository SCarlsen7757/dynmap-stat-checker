RCON_HOST=minecraft
RCON_PORT=25575
RCON_PASSWORD=replace-with-your-rcon-password
DATABASE_URL=postgresql://dynmap:replace-with-a-database-password@postgres:5432/dynmap
POLL_INTERVAL_SECONDS=15
HISTORY_DAYS=30
RCON_TIMEOUT_MS=5000
PORT=3000

# Published dashboard image version. Use a fixed release such as 1.2.3 for reproducible deployments.
DYNMAP_STATS_IMAGE_TAG=latest

# Address and port exposed by Docker on the LAN host.
DASHBOARD_BIND_ADDRESS=192.168.1.10
DASHBOARD_PORT=3000
MINECRAFT_NETWORK_NAME=minecraft

# PostgreSQL container credentials. Keep these in sync with DATABASE_URL.
POSTGRES_DB=dynmap
POSTGRES_USER=dynmap
POSTGRES_PASSWORD=replace-with-a-database-password
