{
  "name": "dynmap-stat-checker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --configLoader runner --host 0.0.0.0\"",
    "dev:web": "vite --configLoader runner --host 127.0.0.1",
    "preview": "vite preview --configLoader runner --host 127.0.0.1",
    "build": "vite build --configLoader runner && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:e2e": "npm run build && playwright test",
    "test:full-stack": "node e2e/run-full-stack.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.6.2",
    "pg": "^8.23.0",
    "rcon-srcds": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "jsdom": "^27.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
